# -----------------------------
# Resolver landing (no ID)
# -----------------------------
/r              /_app/resolver 200
/r/             /_app/resolver 200
/r/index.html   /_app/resolver 200

# QR permanence: /r/<ID> -> canonical
/r/*            /registry/:splat 301

# -----------------------------
# Canonical registry route (single renderer)
# -----------------------------
/registry            /_app/registry 200
/registry/           /_app/registry 200
/registry/index.html /_app/registry 200
/registry/*          /_app/registry 200
